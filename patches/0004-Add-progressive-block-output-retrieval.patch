@@ -0,0 +1,96 @@
+use clap::{Args, Subcommand};
+use local_control::protocol::{BlockListParams, BlockReadParams, BlockSearchParams};
+use local_control::{ActionKind, ControlError};
+
+use super::TargetArgs;
+use super::commands::run_action_with_params;
+use crate::agent::OutputFormat;
+
+#[derive(Debug, Clone, Subcommand)]
+pub enum BlockCommand {
+    /// List block metadata, newest first, without output.
+    List(BlockListArgs),
+    /// Read numbered output rows from a block (1-based; at most 200).
+    Read(BlockReadArgs),
+    /// Search block output, returning matches with surrounding rows.
+    Search(BlockSearchArgs),
+}
+
+#[derive(Debug, Clone, Args)]
+pub struct BlockListArgs {
+    #[command(flatten)]
+    pub target: TargetArgs,
+    /// Continue with blocks older than this block ID.
+    #[arg(long)]
+    pub before: Option<String>,
+    #[arg(long, default_value = "20", value_parser = clap::value_parser!(u32).range(1..=100))]
+    pub limit: u32,
+}
+
+#[derive(Debug, Clone, Args)]
+pub struct BlockReadArgs {
+    #[command(flatten)]
+    pub target: TargetArgs,
+    #[arg(long)]
+    pub block: String,
+    #[arg(long, default_value = "1", value_parser = clap::value_parser!(u32).range(1..))]
+    pub start_line: u32,
+    #[arg(long, default_value = "40", value_parser = clap::value_parser!(u32).range(1..=200))]
+    pub lines: u32,
+}
+
+#[derive(Debug, Clone, Args)]
+pub struct BlockSearchArgs {
+    #[command(flatten)]
+    pub target: TargetArgs,
+    #[arg(long)]
+    pub block: String,
+    /// Literal text by default; use --regex for a regular expression.
+    #[arg(long)]
+    pub pattern: String,
+    #[arg(long)]
+    pub regex: bool,
+    #[arg(long, default_value = "1", value_parser = clap::value_parser!(u32).range(1..))]
+    pub start_line: u32,
+    #[arg(long, default_value = "3", value_parser = clap::value_parser!(u32).range(0..=10))]
+    pub context: u32,
+    #[arg(long, default_value = "20", value_parser = clap::value_parser!(u32).range(1..=50))]
+    pub max_matches: u32,
+}
+
+pub(super) fn run(command: BlockCommand, output_format: OutputFormat) -> Result<(), ControlError> {
+    match command {
+        BlockCommand::List(args) => run_action_with_params(
+            args.target,
+            ActionKind::BlockList,
+            BlockListParams {
+                before: args.before,
+                limit: Some(args.limit),
+            },
+            output_format,
+        ),
+        BlockCommand::Read(args) => run_action_with_params(
+            args.target,
+            ActionKind::BlockRead,
+            BlockReadParams {
+                block: args.block,
+                start_line: Some(args.start_line),
+                lines: Some(args.lines),
+            },
+            output_format,
+        ),
+        BlockCommand::Search(args) => run_action_with_params(
+            args.target,
+            ActionKind::BlockSearch,
+            BlockSearchParams {
+                block: args.block,
+                pattern: args.pattern,
+                regex: args.regex,
+                start_line: Some(args.start_line),
+                context: Some(args.context),
+                max_matches: Some(args.max_matches),
+            },
+            output_format,
+        ),
+    }
+}
