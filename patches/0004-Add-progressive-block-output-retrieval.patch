--- /dev/null
+++ b/crates/local_control/src/block_output.rs
@@ -0,0 +1,169 @@
+use regex::Regex;
+use serde::Serialize;
+
+use crate::protocol::{BlockReadParams, BlockSearchParams, ControlError, ErrorCode};
+
+const MAX_BYTES: usize = 64 * 1024;
+const MAX_LINE_BYTES: usize = 2048;
+const MAX_SCAN_LINES: usize = 10_000;
+
+#[derive(Debug, Serialize)]
+pub struct OutputLine {
+    pub line: usize,
+    pub text: String,
+    pub truncated: bool,
+}
+
+#[derive(Debug, Serialize)]
+pub struct ReadResult {
+    pub lines: Vec<OutputLine>,
+    pub total_lines: usize,
+    pub next_line: Option<usize>,
+    pub truncated: bool,
+}
+
+#[derive(Debug, Serialize)]
+pub struct OutputMatch {
+    pub line: usize,
+    pub lines: Vec<OutputLine>,
+}
+
+#[derive(Debug, Serialize)]
+pub struct SearchResult {
+    pub matches: Vec<OutputMatch>,
+    pub total_lines: usize,
+    pub next_line: Option<usize>,
+    pub truncated: bool,
+}
+
+pub fn bounded(
+    value: Option<u32>,
+    default: usize,
+    max: usize,
+    name: &str,
+) -> Result<usize, ControlError> {
+    let value = value.map_or(default, |value| value as usize);
+    if value == 0 || value > max {
+        return Err(invalid(format!("{name} must be between 1 and {max}")));
+    }
+    Ok(value)
+}
+
+pub fn truncate_text(mut text: String, limit: usize) -> (String, bool) {
+    let truncated = text.len() > limit;
+    if truncated {
+        let mut end = limit;
+        while !text.is_char_boundary(end) {
+            end -= 1;
+        }
+        text.truncate(end);
+    }
+    (text, truncated)
+}
+
+fn invalid(message: String) -> ControlError {
+    ControlError::new(ErrorCode::InvalidParams, message)
+}
+
+fn output_line(index: usize, text: String) -> OutputLine {
+    let (text, truncated) = truncate_text(text, MAX_LINE_BYTES);
+    OutputLine {
+        line: index + 1,
+        text,
+        truncated,
+    }
+}
+
+pub fn read_output(
+    total_lines: usize,
+    params: &BlockReadParams,
+    mut get_line: impl FnMut(usize) -> String,
+) -> Result<ReadResult, ControlError> {
+    let start = bounded(params.start_line, 1, u32::MAX as usize, "start_line")? - 1;
+    let count = bounded(params.lines, 40, 200, "lines")?;
+    let mut lines = Vec::new();
+    let mut bytes = 0;
+    let mut next = start.min(total_lines);
+    for index in start..total_lines.min(start.saturating_add(count)) {
+        let line = output_line(index, get_line(index));
+        if bytes + line.text.len() > MAX_BYTES {
+            break;
+        }
+        bytes += line.text.len();
+        lines.push(line);
+        next = index + 1;
+    }
+    let next_line = (next < total_lines).then_some(next + 1);
+    let truncated = next_line.is_some() || lines.iter().any(|line| line.truncated);
+    Ok(ReadResult {
+        lines,
+        total_lines,
+        next_line,
+        truncated,
+    })
+}
+
+pub fn search_output(
+    total_lines: usize,
+    params: &BlockSearchParams,
+    mut get_line: impl FnMut(usize) -> String,
+) -> Result<SearchResult, ControlError> {
+    let start = bounded(params.start_line, 1, u32::MAX as usize, "start_line")? - 1;
+    let max_matches = bounded(params.max_matches, 20, 50, "max_matches")?;
+    let context = params.context.unwrap_or(3) as usize;
+    if context > 10 || params.pattern.is_empty() || params.pattern.len() > 4096 {
+        return Err(invalid(
+            "context must be at most 10; pattern must contain 1–4096 bytes".into(),
+        ));
+    }
+    let regex = params
+        .regex
+        .then(|| Regex::new(&params.pattern))
+        .transpose()
+        .map_err(|error| invalid(format!("invalid regex: {error}")))?;
+    let mut matches = Vec::new();
+    let mut bytes = 0;
+    let mut next = start.min(total_lines);
+    for index in start..total_lines.min(start.saturating_add(MAX_SCAN_LINES)) {
+        let text = get_line(index);
+        let matched = regex.as_ref().map_or_else(
+            || text.contains(&params.pattern),
+            |regex| regex.is_match(&text),
+        );
+        if matched {
+            let lines: Vec<_> = (index.saturating_sub(context)
+                ..total_lines.min(index + context + 1))
+                .map(|index| output_line(index, get_line(index)))
+                .collect();
+            let match_bytes: usize = lines.iter().map(|line| line.text.len()).sum();
+            if bytes + match_bytes > MAX_BYTES {
+                break;
+            }
+            bytes += match_bytes;
+            matches.push(OutputMatch {
+                line: index + 1,
+                lines,
+            });
+        }
+        next = index + 1;
+        if matches.len() == max_matches {
+            break;
+        }
+    }
+    let next_line = (next < total_lines).then_some(next + 1);
+    let truncated = next_line.is_some()
+        || matches
+            .iter()
+            .flat_map(|item| &item.lines)
+            .any(|line| line.truncated);
+    Ok(SearchResult {
+        matches,
+        total_lines,
+        next_line,
+        truncated,
+    })
+}
+
