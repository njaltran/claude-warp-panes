diff --git a/app/src/local_control/handlers/blocks.rs b/app/src/local_control/handlers/blocks.rs
new file mode 100644
index 0000000..5b6544d
--- /dev/null
+++ b/app/src/local_control/handlers/blocks.rs
@@ -0,0 +1,169 @@
+use ::local_control::block_output::{bounded, read_output, search_output, truncate_text};
+use ::local_control::protocol::{
+    BlockListParams, BlockReadParams, BlockSearchParams, TargetSelector,
+};
+use ::local_control::{Action, ActionKind, ControlError, ErrorCode, InstanceId};
+use serde_json::{Value, json};
+use warp_terminal::model::grid::RespectDisplayedOutput;
+use warp_terminal::model::index::Point;
+use warp_terminal::model::secrets::RespectObfuscatedSecrets;
+use warpui::ModelContext;
+
+use super::metadata_config::select_single_pane_entry;
+use crate::local_control::LocalControlBridge;
+use crate::terminal::model::TerminalModel;
+use crate::terminal::model::block::{Block, BlockState};
+
+pub(crate) fn handle(
+    instance_id: &Option<InstanceId>,
+    target: &TargetSelector,
+    action: &Action,
+    ctx: &mut ModelContext<LocalControlBridge>,
+) -> Result<Value, ControlError> {
+    let entry = select_single_pane_entry(target, action.kind, ctx)?;
+    let terminal = entry
+        .pane_group
+        .read(ctx, |group, ctx| {
+            group.terminal_view_from_pane_id(entry.pane_id, ctx)
+        })
+        .ok_or_else(|| {
+            ControlError::new(
+                ErrorCode::MissingTarget,
+                "block actions require a terminal pane",
+            )
+        })?;
+    let mut result = terminal.read(ctx, |view, _| {
+        let model = view.model.lock();
+        block_response(&model, action)
+    })?;
+    result["action"] = json!(action.kind.as_str());
+    result["ok"] = json!(true);
+    result["instance_id"] = json!(instance_id.as_ref().map(|id| id.0.as_str()));
+    result["tab_id"] = json!(entry.tab_id);
+    result["pane_id"] = json!(entry.pane_id.to_string());
+    Ok(result)
+}
+
+fn metadata(block: &Block) -> Value {
+    let (state, exit_code) = match block.state() {
+        BlockState::BeforeExecution => ("pending", None),
+        BlockState::Executing => ("running", None),
+        BlockState::DoneWithExecution => ("completed", Some(block.exit_code().value())),
+        BlockState::DoneWithNoExecution => ("not_executed", None),
+        BlockState::Background => ("background", None),
+        BlockState::Static => ("static", None),
+    };
+    let (command, command_truncated) =
+        truncate_text(block.command_with_secrets_obfuscated(false), 512);
+    json!({
+        "block_id": block.id().as_str(),
+        "command": command,
+        "command_truncated": command_truncated,
+        "state": state,
+        "exit_code": exit_code,
+        "total_lines": block.output_grid().len(),
+        "line_unit": "terminal_row",
+        "columns": block.output_grid().end_point().col + 1,
+        "evicted_lines": block.output_grid().grid_handler().num_lines_truncated(),
+    })
+}
+
+fn line_text(block: &Block, index: usize) -> String {
+    let grid = block.output_grid();
+    grid.grid_handler()
+        .bounds_to_string(
+            Point::new(index, 0),
+            Point::new(index, grid.end_point().col),
+            false,
+            RespectObfuscatedSecrets::Yes,
+            false,
+            RespectDisplayedOutput::No,
+        )
+        .trim_end_matches('\n')
+        .to_owned()
+}
+
+fn block_response(model: &TerminalModel, action: &Action) -> Result<Value, ControlError> {
+    let list = model.block_list();
+    let visible = || {
+        list.blocks()
+            .iter()
+            .filter(|block| block.is_visible(list.transcript_scope()))
+    };
+    if action.kind == ActionKind::BlockList {
+        let params: BlockListParams = action.params_as()?;
+        let limit = bounded(params.limit, 20, 100, "limit")?;
+        let blocks: Vec<_> = visible().rev().collect();
+        let start = match params.before {
+            Some(before) => {
+                blocks
+                    .iter()
+                    .position(|block| block.id().as_str() == before)
+                    .ok_or_else(|| {
+                        ControlError::new(
+                            ErrorCode::MissingTarget,
+                            "pagination block no longer exists",
+                        )
+                    })?
+                    + 1
+            }
+            None => 0,
+        };
+        let page: Vec<_> = blocks
+            .iter()
+            .skip(start)
+            .take(limit)
+            .map(|block| metadata(block))
+            .collect();
+        let has_more = start + page.len() < blocks.len();
+        let next_before = if has_more {
+            page.last().map(|item| item["block_id"].clone())
+        } else {
+            None
+        };
+        return Ok(json!({ "blocks": page, "next_before": next_before, "truncated": has_more }));
+    }
+    let block_id = match action.kind {
+        ActionKind::BlockRead => action.params_as::<BlockReadParams>()?.block,
+        ActionKind::BlockSearch => action.params_as::<BlockSearchParams>()?.block,
+        _ => {
+            return Err(ControlError::new(
+                ErrorCode::UnsupportedAction,
+                "expected a block retrieval action",
+            ));
+        }
+    };
+    let block = visible()
+        .find(|block| block.id().as_str() == block_id)
+        .ok_or_else(|| {
+            ControlError::new(
+                ErrorCode::MissingTarget,
+                "block does not exist in the selected pane",
+            )
+        })?;
+    let total = block.output_grid().len();
+    let mut result = match action.kind {
+        ActionKind::BlockRead => {
+            json!(read_output(
+                total,
+                &action.params_as()?,
+                |index| line_text(block, index)
+            )?)
+        }
+        ActionKind::BlockSearch => json!(search_output(total, &action.params_as()?, |index| {
+            line_text(block, index)
+        })?),
+        _ => {
+            return Err(ControlError::new(
+                ErrorCode::UnsupportedAction,
+                "expected a block retrieval action",
+            ));
+        }
+    };
+    result["block"] = metadata(block);
+    Ok(result)
+}
+
+#[cfg(test)]
+#[path = "blocks_tests.rs"]
+mod tests;
