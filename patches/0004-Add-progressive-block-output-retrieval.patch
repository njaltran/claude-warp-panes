+use super::*;
+
+fn read_params(start_line: u32, lines: u32) -> BlockReadParams {
+    BlockReadParams {
+        block: "test".into(),
+        start_line: Some(start_line),
+        lines: Some(lines),
+    }
+}
+
+fn search_params(pattern: &str) -> BlockSearchParams {
+    BlockSearchParams {
+        block: "test".into(),
+        pattern: pattern.into(),
+        regex: false,
+        start_line: None,
+        context: Some(0),
+        max_matches: None,
+    }
+}
+
+#[test]
+fn reads_only_requested_rows_and_returns_continuation() {
+    let result = read_output(5, &read_params(2, 2), |index| {
+        assert!((1..=2).contains(&index));
+        format!("row {index}")
+    })
+    .unwrap();
+    assert_eq!(result.lines[0].line, 2);
+    assert_eq!(result.lines[1].text, "row 2");
+    assert_eq!(result.next_line, Some(4));
+    assert!(result.truncated);
+}
+
+#[test]
+fn empty_or_past_end_reads_do_not_fetch_output() {
+    let result = read_output(0, &read_params(1, 40), |_| panic!("empty output")).unwrap();
+    assert!(result.lines.is_empty());
+    assert_eq!(result.next_line, None);
+    let result = read_output(3, &read_params(5, 40), |_| panic!("past end")).unwrap();
+    assert!(result.lines.is_empty());
+    assert_eq!(result.next_line, None);
+}
+
+#[test]
+fn rejects_zero_and_excessive_read_limits() {
+    assert!(read_output(1, &read_params(0, 1), |_| String::new()).is_err());
+    assert!(read_output(1, &read_params(1, 0), |_| String::new()).is_err());
+    assert!(read_output(1, &read_params(1, 201), |_| String::new()).is_err());
+}
+
+#[test]
+fn search_is_literal_by_default() {
+    let rows = ["errorX", "error.", "other"];
+    let result = search_output(rows.len(), &search_params("error."), |index| {
+        rows[index].into()
+    })
+    .unwrap();
+    assert_eq!(result.matches.len(), 1);
+    assert_eq!(result.matches[0].line, 2);
+    assert_eq!(result.next_line, None);
+}
+
+#[test]
+fn regex_search_returns_context_and_resumes_without_skipping_matches() {
+    let rows = ["before", "error", "FAILED", "after"];
+    let mut params = search_params("error|FAILED");
+    params.regex = true;
+    params.context = Some(1);
+    params.max_matches = Some(1);
+    let result = search_output(4, &params, |index| rows[index].into()).unwrap();
+    assert_eq!(result.matches[0].line, 2);
+    assert_eq!(result.matches[0].lines.len(), 3);
+    assert_eq!(result.matches[0].lines[0].text, "before");
+    assert_eq!(result.next_line, Some(3));
+    params.start_line = Some(3);
+    let result = search_output(4, &params, |index| rows[index].into()).unwrap();
+    assert_eq!(result.matches[0].line, 3);
+}
+
+#[test]
+fn rejects_invalid_regex_and_search_limits() {
+    let mut params = search_params("[");
+    params.regex = true;
+    assert!(search_output(1, &params, |_| String::new()).is_err());
+    assert!(search_output(1, &search_params(""), |_| String::new()).is_err());
+    params.regex = false;
+    params.context = Some(11);
+    assert!(search_output(1, &params, |_| String::new()).is_err());
+    params.context = Some(0);
+    params.max_matches = Some(0);
+    assert!(search_output(1, &params, |_| String::new()).is_err());
+}
+
+#[test]
+fn search_scan_budget_returns_continuation_even_without_matches() {
+    let result = search_output(20_000, &search_params("absent"), |_| "other".into()).unwrap();
+    assert!(result.matches.is_empty());
+    assert_eq!(result.next_line, Some(10_001));
+    assert!(result.truncated);
+}
+
+#[test]
+fn byte_limits_preserve_unicode_and_report_loss() {
+    let result = read_output(100, &read_params(1, 100), |_| "界".repeat(1000)).unwrap();
+    assert!(result.lines[0].truncated);
+    assert_eq!(result.lines[0].text.len(), 2046);
+    assert!(
+        result
+            .lines
+            .iter()
+            .map(|line| line.text.len())
+            .sum::<usize>()
+            <= MAX_BYTES
+    );
+    assert_eq!(result.next_line, Some(33));
+}
+
+#[test]
+fn search_byte_limit_resumes_at_first_unreturned_match() {
+    let mut params = search_params("x");
+    params.context = Some(10);
+    let result = search_output(100, &params, |_| "x".repeat(2048)).unwrap();
+    assert_eq!(result.matches.len(), 2);
+    assert_eq!(result.next_line, Some(3));
+}
