+#[test]
+fn retrieves_selected_block_instead_of_recent_pane_output() {
+    let mut model = TerminalModel::mock(None, None);
+    model.simulate_block("first", "one\r\ntwo\r\nthree");
+    let listing = block_response(&model, &action(ActionKind::BlockList, json!({}))).unwrap();
+    let block = listing["blocks"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|block| block["command"] == "first")
+        .unwrap();
+    let id = block["block_id"].clone();
+    model.simulate_block("second", "other");
+    let result = block_response(
+        &model,
+        &action(
+            ActionKind::BlockRead,
+            json!({"block": id, "start_line": 2, "lines": 1}),
+        ),
+    )
+    .unwrap();
+    assert_eq!(result["lines"][0]["line"], 2);
+    assert_eq!(result["lines"][0]["text"], "two");
+    assert_eq!(result["next_line"], 3);
+    assert_eq!(result["block"]["state"], "completed");
+}
+
+#[test]
+fn lists_metadata_without_output_and_paginates_by_id() {
+    let mut model = TerminalModel::mock(None, None);
+    model.simulate_block("first", "private output");
+    model.simulate_block("second", "more output");
+    let result =
+        block_response(&model, &action(ActionKind::BlockList, json!({"limit": 1}))).unwrap();
+    assert_eq!(result["blocks"].as_array().unwrap().len(), 1);
+    assert!(!result.to_string().contains("private output"));
+    let next = block_response(
+        &model,
+        &action(
+            ActionKind::BlockList,
+            json!({"before": result["next_before"], "limit": 1}),
+        ),
+    )
+    .unwrap();
+    assert_ne!(
+        result["blocks"][0]["block_id"],
+        next["blocks"][0]["block_id"]
+    );
+}
+
+#[test]
+fn missing_block_is_not_replaced_with_latest() {
+    let mut model = TerminalModel::mock(None, None);
+    model.simulate_block("test", "output");
+    let error = block_response(
+        &model,
+        &action(ActionKind::BlockRead, json!({"block": "missing"})),
+    )
+    .unwrap_err();
+    assert_eq!(error.code, ErrorCode::MissingTarget);
+}
