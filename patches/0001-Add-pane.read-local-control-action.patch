+/// Reads the visible content of a terminal pane: the alternate screen when a
+/// full-screen program is running, otherwise the recent blocks and input. Reuses
+/// the terminal view's accessibility content so both cases match what screen
+/// readers see.
+pub(crate) fn pane_read(
+    instance_id: &Option<InstanceId>,
+    target: &TargetSelector,
+    action: &::local_control::Action,
+    ctx: &mut ModelContext<LocalControlBridge>,
+) -> Result<serde_json::Value, ControlError> {
+    let PaneReadParams { lines } = action.params_as()?;
+    let entry = select_single_pane_entry(target, ActionKind::PaneRead, ctx)?;
+    let terminal_view = entry
+        .pane_group
+        .read(ctx, |pane_group, ctx| {
+            pane_group.terminal_view_from_pane_id(entry.pane_id, ctx)
+        })
+        .ok_or_else(|| {
+            ControlError::new(
+                ErrorCode::MissingTarget,
+                "pane.read requires a terminal pane",
+            )
+        })?;
+    let content = terminal_view
+        .update(ctx, |terminal_view, ctx| {
+            terminal_view.accessibility_data(ctx)
+        })
+        .map(|data| data.content)
+        .unwrap_or_default();
+    let text = match lines {
+        Some(lines) => tail_lines(&content, lines as usize),
+        None => content,
+    };
+    Ok(json!({
+        "action": ActionKind::PaneRead.as_str(),
+        "ok": true,
+        "instance_id": instance_id.as_ref().map(|id| id.0.as_str()),
+        "tab_id": entry.tab_id,
+        "pane_id": entry.pane_id.to_string(),
+        "text": text,
+    }))
+}
+
+fn tail_lines(content: &str, lines: usize) -> String {
+    let all: Vec<&str> = content.trim_end().lines().collect();
+    all[all.len().saturating_sub(lines)..].join("\n")
+}
